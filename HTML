<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spent. | Student Finance</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap" rel="stylesheet">
    <style>
        body { 
            background-color: #050505; 
            color: #ffffff; 
            font-family: 'Space Grotesk', sans-serif;
            background-image: radial-gradient(circle at 50% -20%, #3b82f622, transparent);
        }
        .bento-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            transition: transform 0.2s ease;
        }
        .bento-card:hover { transform: translateY(-2px); border-color: #3b82f6; }
        input, select { background: #111 !important; border: 1px solid #333 !important; color: white !important; }
        .gradient-text { background: linear-gradient(90deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    </style>
</head>
<body class="p-6 md:p-12">
    <div class="max-w-4xl mx-auto">
        <header class="flex justify-between items-end mb-10">
            <div>
                <h1 class="text-4xl font-bold tracking-tighter">Spent<span class="text-blue-500">.</span></h1>
                <p class="text-gray-500 text-sm">Main Character Energy for your Wallet</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-gray-500 uppercase tracking-widest">Balance</p>
                <h2 id="balance" class="text-3xl font-bold">$0.00</h2>
            </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="md:col-span-1 space-y-6">
                <div class="bento-card p-6 rounded-3xl">
                    <h3 class="font-bold mb-4 flex items-center gap-2"><span>⚡</span> Log it</h3>
                    <form id="tx-form" class="space-y-4">
                        <input type="text" id="desc" placeholder="What'd you buy?" class="w-full p-3 rounded-xl outline-none" required>
                        <input type="number" id="amt" placeholder="Amount" class="w-full p-3 rounded-xl outline-none" required>
                        <select id="type" class="w-full p-3 rounded-xl outline-none">
                            <option value="expense">Expense 💸</option>
                            <option value="income">Income 💰</option>
                        </select>
                        <button class="w-full bg-blue-600 hover:bg-blue-500 py-3 rounded-xl font-bold transition-all shadow-lg shadow-blue-900/20">Add Entry</button>
                    </form>
                </div>
            </div>

            <div class="md:col-span-2 space-y-6">
                <div class="grid grid-cols-2 gap-4">
                    <div class="bento-card p-5 rounded-3xl">
                        <p class="text-xs text-gray-400 mb-1">Inflow</p>
                        <p id="in" class="text-xl font-bold text-green-400">+$0</p>
                    </div>
                    <div class="bento-card p-5 rounded-3xl">
                        <p class="text-xs text-gray-400 mb-1">Outflow</p>
                        <p id="out" class="text-xl font-bold text-red-400">-$0</p>
                    </div>
                </div>

                <div class="bento-card p-6 rounded-3xl min-h-[300px]">
                    <h3 class="font-bold mb-4 text-gray-400">The Feed</h3>
                    <div id="feed" class="space-y-3 text-sm">
                        <p class="text-gray-600 italic">No movement yet. Go secure the bag.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('tx-form');
        const feed = document.getElementById('feed');
        let data = JSON.parse(localStorage.getItem('spent_data')) || [];

        function updateUI() {
            const inc = data.filter(x => x.type === 'income').reduce((s, x) => s + x.amt, 0);
            const exp = data.filter(x => x.type === 'expense').reduce((s, x) => s + x.amt, 0);
            
            document.getElementById('balance').innerText = `$${(inc - exp).toFixed(2)}`;
            document.getElementById('in').innerText = `+$${inc}`;
            document.getElementById('out').innerText = `-$${exp}`;
            
            feed.innerHTML = data.length ? '' : '<p class="text-gray-600 italic">No movement yet.</p>';
            data.slice().reverse().forEach(item => {
                const div = document.createElement('div');
                div.className = "flex justify-between items-center bg-white/5 p-4 rounded-2xl border border-white/5";
                div.innerHTML = `<div><p class="font-medium">${item.desc}</p></div>
                                 <p class="font-bold ${item.type === 'income' ? 'text-green-400' : 'text-white'}">
                                 ${item.type === 'income' ? '+' : '-'}$${item.amt}</p>`;
                feed.appendChild(div);
            });
            localStorage.setItem('spent_data', JSON.stringify(data));
        }

        form.addEventListener('submit', e => {
            e.preventDefault();
            data.push({
                desc: document.getElementById('desc').value,
                amt: parseFloat(document.getElementById('amt').value),
                type: document.getElementById('type').value,
                id: Date.now()
            });
            updateUI();
            form.reset();
        });

        updateUI();
    </script>
</body>
</html>
